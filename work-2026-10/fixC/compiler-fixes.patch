@@ -0,0 +1,130 @@
+#!/usr/bin/env python3
+"""Executable compiler numerical regressions against pinned TorchAO.
+Requires torch==2.10 and torchao==0.16. Run with --compiler, --runtime, --work-dir.
+"""
+import argparse, json, os, subprocess, tempfile
+from pathlib import Path
+import numpy as np
+import ml_dtypes
+import torch
+from torchao.quantization.quant_primitives import _choose_qparams_affine, _quantize_affine
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--compiler',required=True,type=Path)
+parser.add_argument('--runtime',required=True,type=Path)
+parser.add_argument('--work-dir',type=Path)
+args=parser.parse_args()
+C=args.compiler.resolve();RUN=args.runtime.resolve()
+D=args.work_dir or Path(tempfile.mkdtemp(prefix='affine-numerics-'))
+D.mkdir(parents=True,exist_ok=True)
+os.environ['OMP_NUM_THREADS']='8';torch.set_num_threads(8)
+commands=[];results={}
+def invoke(cmd,log):
+ commands.append([str(a) for a in cmd]);(D/'commands.json').write_text(json.dumps(commands,indent=2))
+ with log.open('w') as f:return subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT).returncode
+def execute(name,mlir,x,types,input_dtype="f32"):
+ p=D/(name+'.mlir');p.write_text(mlir);inp=D/(name+'-input.bin');x.astype(ml_dtypes.bfloat16 if input_dtype=='bf16' else 'f4').tofile(inp)
+ vmfb=D/(name+'.vmfb')
+ code=invoke([C,p,'--iree-hal-target-backends=llvm-cpu','--iree-llvmcpu-target-cpu=host','--iree-llvmcpu-number-of-threads=8','--iree-input-demote-f64-to-f32=false','--iree-vm-target-extension-f64=true','--iree-vm-target-truncate-unsupported-floats=false','-o',vmfb],D/(name+'-compile.log'))
+ if code:return {'compile_exit':code},None
+ outs=[D/f'{name}-{i}.bin' for i in range(len(types))]
+ shape='x'.join(map(str,x.shape))+'x'+input_dtype
+ code=invoke([RUN,f'--module={vmfb}','--device=local-task','--task_topology_group_count=8','--function=main',f'--input={shape}=@{inp}']+[f'--output=@{o}' for o in outs],D/(name+'-run.log'))
+ if code:return {'runtime_exit':code},None
+ return {},[np.fromfile(p,dtype=t) for p,t in zip(outs,types)]
+def tt(shape,dtype):return '!torch.vtensor<['+','.join(map(str,shape))+'],'+dtype+'>'
+def quant_ir(shape,block,keep=False,qmin=-127,qmax=127,fixed=None,unsigned=False,mapping='SYMMETRIC'):
+ qt='ui8' if unsigned else 'si8';xs=tt(shape,'f32');out=tt(shape,qt)
+ # Mirror the pinned _get_reduction_params, including singleton block axes.
+ compact=[]
+ for n,b in zip(shape,block):
+  if b==1:compact.append(n)
+  elif b!=n:compact.append(n//b)
+ ps=[n//b for n,b in zip(shape,block)] if keep else compact
+ pt=tt(ps,'f32');decls='\n'.join(f'%b{i} = torch.constant.int {b}' for i,b in enumerate(block))
+ bs=', '.join(f'%b{i}' for i in range(len(block)))
+ btypes=', '.join('!torch.int' for _ in block)
+ body=f'''%map = torch.constant.str "{mapping}"
+%dt = torch.constant.int {0 if unsigned else 1}
+%lo = torch.constant.int {qmin}
+%hi = torch.constant.int {qmax}
+%eps = torch.constant.float 1.000000e-05
+%none = torch.constant.none
+%keep = torch.constant.bool {'true' if keep else 'false'}
+{decls}
+%block = torch.prim.ListConstruct {bs} : ({btypes}) -> !torch.list<int>
+'''
+ if fixed is None:
+  body+=f'''%p:2 = torch.operator "torch.torchao.choose_qparams_affine"(%x, %map, %block, %dt, %lo, %hi, %eps, %none, %none, %keep) : ({xs}, !torch.str, !torch.list<int>, !torch.int, !torch.int, !torch.int, !torch.float, !torch.none, !torch.none, !torch.bool) -> ({pt}, {pt})\n'''
+  sc,zp='%p#0','%p#1'
+ else:
+  dims='x'.join(map(str,ps))+('x' if ps else '')
+  body+=f'%sc = torch.vtensor.literal(dense<{fixed[0]:.8e}> : tensor<{dims}f32>) : {pt}\n%zp = torch.vtensor.literal(dense<{fixed[1]:.8e}> : tensor<{dims}f32>) : {pt}\n'
+  sc,zp='%sc','%zp'
+ body+=f'''%q = torch.operator "torch.torchao.quantize_affine"(%x, %block, {sc}, {zp}, %dt, %lo, %hi) : ({xs}, !torch.list<int>, {pt}, {pt}, !torch.int, !torch.int, !torch.int) -> {out}
+return {sc}, {zp}, %q : {pt}, {pt}, {out}
+'''
+ return f'module {{ func.func @main(%x: {xs}) -> ({pt}, {pt}, {out}) {{\n{body}}}\n}}',ps
+cases=[
+ ('per_token',np.array([[-2,-.6,.6,2],[-4,-1.5,1.5,4]],'f4'),[1,4],False,-127,127,None,False),
+ ('zeros_epsilon',np.array([[0,0,0,0],[1e-8,-2e-8,0,1e-9]],'f4'),[1,4],False,-127,127,None,False),
+ ('partial_blocks',np.linspace(-5,3,24,dtype='f4').reshape(3,8),[1,4],False,-127,127,None,False),
+ ('dynamic_per_token',np.array([[-2,-.6,.6,2],[-4,-1.5,1.5,4]],'f4'),[1,4],False,-127,127,None,False),
+ ('per_channel',np.linspace(-8,7,15,dtype='f4').reshape(3,5),[3,1],False,-127,127,None,False),
+ ('keepdim',np.linspace(-5,3,24,dtype='f4').reshape(3,8),[1,8],True,-127,127,None,False),
+ ('all_axes',np.linspace(-8,7,15,dtype='f4').reshape(3,5),[3,5],False,-127,127,None,False),
+ ('ties_saturation',np.array([[-200,-3.5,-2.5,-1.5,-.5,0,.5,1.5,2.5,3.5,200]],'f4'),[1,11],False,-127,127,(1,0),False),
+ ('integer_zp',np.array([[-200,-3.5,-2.5,-1.5,-.5,0,.5,1.5,2.5,3.5,200]],'f4'),[1,11],False,-128,127,(1,3),False),
+ ('unsigned_zp',np.array([[-200,-3.5,-2.5,-1.5,-.5,0,.5,1.5,2.5,3.5,200]],'f4'),[1,11],False,0,255,(1,128),True),
+ ('unsigned_choose',np.linspace(-8,7,15,dtype='f4').reshape(3,5),[3,1],False,0,255,None,True),
+]
+for name,x,block,keep,lo,hi,fixed,unsigned in cases:
+ mlir,ps=quant_ir(x.shape,block,keep,lo,hi,fixed,unsigned)
+ if name=='dynamic_per_token':mlir=mlir.replace('[2,4]','[?,4]').replace('[2],f32','[?],f32')
+ result,actual=execute(name,mlir,x,['f4','f4','u1' if unsigned else 'i1'])
+ if actual is not None:
+  t=torch.from_numpy(x);dtype=torch.uint8 if unsigned else torch.int8
+  if fixed is None:s,z=_choose_qparams_affine(t,'SYMMETRIC',block,dtype,lo,hi,1e-5,torch.float32,torch.float32,keep)
+  else:s,z=torch.full(ps,fixed[0],dtype=torch.float32),torch.full(ps,fixed[1],dtype=torch.float32)
+  q=_quantize_affine(t,block,s,z,dtype,lo,hi)
+  expected=[s.numpy().ravel(),z.numpy().ravel(),q.numpy().ravel()]
+  result.update(scale_max_abs=float(np.max(abs(actual[0]-expected[0]))),scale_pass=bool(np.allclose(actual[0],expected[0],rtol=2e-7,atol=0)),zero_exact=bool(np.array_equal(actual[1],expected[1])),quant_exact=bool(np.array_equal(actual[2],expected[2])),quant_mismatches=int(np.count_nonzero(actual[2]!=expected[2])))
+  result['pass']=result['scale_pass'] and result['zero_exact'] and result['quant_exact']
+ results[name]=result
+ (D/'results.json').write_text(json.dumps(results,indent=2));print(name,result,flush=True)
+# Requested scale/zero dtype and BF16 arithmetic are independently exercised.
+x=np.array([[-2,-.6,.6,2],[-4,-1.5,1.5,4]],'f4')
+for name in ['requested_f64_qparams','bf16_qparams']:
+ mlir,_=quant_ir(x.shape,[1,4])
+ if name=='requested_f64_qparams':
+  mlir=mlir.replace('[2],f32','[2],f64').replace('%none = torch.constant.none','%none = torch.constant.none\n%f64 = torch.constant.int 7').replace('%eps, %none, %none, %keep','%eps, %f64, %f64, %keep').replace('!torch.float, !torch.none, !torch.none, !torch.bool','!torch.float, !torch.int, !torch.int, !torch.bool')
+  dtype=torch.float64;input_dtype='f32';transport='f8';t=torch.from_numpy(x)
+ else:
+  mlir=mlir.replace('f32','bf16');dtype=torch.bfloat16;input_dtype='bf16';transport=ml_dtypes.bfloat16;t=torch.from_numpy(x).to(dtype)
+ result,actual=execute(name,mlir,x,[transport,transport,'i1'],input_dtype)
+ if actual is not None:
+  sc,zp=_choose_qparams_affine(t,'SYMMETRIC',[1,4],torch.int8,-127,127,1e-5,dtype,dtype,False)
+  q=_quantize_affine(t,[1,4],sc,zp,torch.int8,-127,127)
+  scale_error=np.max(abs(actual[0].astype('f8')-sc.to(torch.float64).numpy().ravel()))
+  zero_exact=np.array_equal(actual[1].astype('f8'),zp.to(torch.float64).numpy().ravel())
+  qexact=np.array_equal(actual[2],q.numpy().ravel())
+  result.update(scale_max_abs=float(scale_error),zero_exact=bool(zero_exact),quant_exact=bool(qexact),pass_=bool(scale_error==0 and zero_exact and qexact));result['pass']=result.pop('pass_')
+ results[name]=result
+ (D/'results.json').write_text(json.dumps(results,indent=2));print(name,result,flush=True)
+# GELU sweep catches the local coefficient error at a tighter local gate.
+x=np.linspace(-8,8,4097,dtype='f4')
+mlir='''module {func.func @main(%x: !torch.vtensor<[4097],f32>) -> !torch.vtensor<[4097],f32> {
+%approx = torch.constant.str "tanh"
+%y = torch.aten.gelu %x, %approx : !torch.vtensor<[4097],f32>, !torch.str -> !torch.vtensor<[4097],f32>
+return %y : !torch.vtensor<[4097],f32>
+}}'''
+result,actual=execute('gelu',mlir,x,['f4'])
+if actual is not None:
+ expected=torch.nn.functional.gelu(torch.from_numpy(x),approximate='tanh').numpy()
+ err=abs(actual[0]-expected);result.update(max_abs=float(err.max()),pass_=bool(np.all(err<=2e-6)));result['pass']=result.pop('pass_')
+results['gelu']=result
+# Unsupported mappings must fail explicitly, never silently return unit scales.
+mlir,_=quant_ir((2,4),[1,4],mapping='ASYMMETRIC')
+result,actual=execute('unsupported_mapping',mlir,np.ones((2,4),'f4'),['f4','f4','i1'])
+result['pass']=result.get('compile_exit',0)!=0 and 'only SYMMETRIC affine qparams are supported' in (D/'unsupported_mapping-compile.log').read_text();results['unsupported_mapping']=result
+(D/'results.json').write_text(json.dumps(results,indent=2));print(json.dumps(results,indent=2))
+raise SystemExit(0 if all(r.get('pass',False) for r in results.values()) else 2)
