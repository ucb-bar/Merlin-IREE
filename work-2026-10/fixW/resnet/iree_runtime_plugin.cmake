iree_cc_binary(NAME resnet SRCS "${CMAKE_CURRENT_LIST_DIR}/libc_strict.c" "${CMAKE_CURRENT_LIST_DIR}/runner.c" "${CMAKE_CURRENT_LIST_DIR}/embed.S" DEPS iree::base iree::hal iree::hal::drivers::local_sync::sync_driver iree::hal::local iree::hal::local::loaders::embedded_elf_loader iree::modules::hal iree::vm iree::vm::bytecode::module)
get_property(allTargets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
foreach(t IN LISTS allTargets)
 if(t MATCHES "resnet$")
 target_link_libraries(${t} PRIVATE "-Wl,--defsym=__merlin_heap_size=134217728" "-Wl,--defsym=__merlin_stack_size_min=8388608")
 endif()
endforeach()
iree_cc_binary(NAME stdio_default SRCS "${CMAKE_CURRENT_LIST_DIR}/stdio_probe.c")
iree_cc_binary(NAME stdio_buffered SRCS "${CMAKE_CURRENT_LIST_DIR}/stdio_probe.c")
get_property(ioTargets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
foreach(t IN LISTS ioTargets)
 if(t MATCHES "stdio_default$" OR t MATCHES "stdio_buffered$")
  target_link_options(${t} PRIVATE "-Wl,--wrap=_write")
 endif()
 if(t MATCHES "stdio_buffered$")
  target_compile_definitions(${t} PRIVATE BUFFER_OUTPUT=1)
 endif()
endforeach()
# This bare-metal toolchain's link template uses LINK_LIBRARIES, not LINK_FLAGS.
target_link_libraries(iree_.._.._.._resnet_stdio_default PRIVATE "-Wl,--wrap=_write")
target_link_libraries(iree_.._.._.._resnet_stdio_buffered PRIVATE "-Wl,--wrap=_write")
