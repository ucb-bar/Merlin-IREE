+// Native integer matrix multiplication has signed i8 inputs and i32
+// accumulation. Reuse the existing mm lowering after checking this contract.
+class ConvertAtenIntMmOp : public OpConversionPattern<Aten_IntMmOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+  LogicalResult matchAndRewrite(Aten_IntMmOp op, OpAdaptor adaptor,
+      ConversionPatternRewriter &rewriter) const override {
+    auto lhs = dyn_cast<ValueTensorType>(op.getSelf().getType());
+    auto rhs = dyn_cast<ValueTensorType>(op.getMat2().getType());
+    auto result = dyn_cast<ValueTensorType>(op.getType());
+    if (!lhs || !rhs || !result || !lhs.hasSizes() || !rhs.hasSizes() ||
+        lhs.getSizes().size() != 2 || rhs.getSizes().size() != 2 ||
+        !lhs.getDtype().isSignedInteger(8) ||
+        !rhs.getDtype().isSignedInteger(8) ||
+        !result.getDtype().isSignedInteger(32))
+      return rewriter.notifyMatchFailure(op,
+          "expected rank-2 signed i8 inputs and signed i32 output");
+    rewriter.replaceOpWithNewOp<AtenMmOp>(op, op.getType(),
+                                        op.getSelf(), op.getMat2());
+    return success();
+  }
+};
 
