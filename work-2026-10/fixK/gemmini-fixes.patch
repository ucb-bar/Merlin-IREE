+    if (!def || def->getBlock() != anchor->getBlock() || !isPure(def))
+      return failure();
+    if (!visited.insert(def).second)
+      return success();
+    for (Value operand : def->getOperands())
+      if (failed(collect(operand)))
+        return failure();
+    ordered.push_back(def);
+    return success();
+  };
+  for (Value value : values)
+    if (failed(collect(value)))
+      return failure();
+  for (Operation *def : ordered)
+    rewriter.moveOpBefore(def, anchor);
+  return success();
