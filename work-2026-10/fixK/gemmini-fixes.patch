+// Match TorchAO's _get_reduction_params: split partial blocks into a
+// group axis and a reduction axis. Dynamic dimensions are supported when
+// block_size=1; dynamic blocked axes require a runtime divisibility contract
+// and are deliberately rejected instead of inventing a qparam shape.
+struct AffineBlockLayout {
+  SmallVector<int64_t> shape;
+  SmallVector<ReassociationIndices> reassociation;
+  SmallVector<bool> reduce;
+  SmallVector<int64_t> retainedInputDims;
+};
+
+static FailureOr<AffineBlockLayout>
+getAffineBlockLayout(Value block, RankedTensorType inputType) {
+  SmallVector<int64_t> sizes;
+  if (!matchPattern(block, m_TorchListOfConstantInts(sizes)) ||
+      sizes.size() != static_cast<size_t>(inputType.getRank()))
+    return failure();
+  AffineBlockLayout layout;
+  for (int64_t i = 0; i < inputType.getRank(); ++i) {
+    int64_t n = inputType.getDimSize(i), bs = sizes[i];
+    if (bs <= 0 || n == 0 ||
+        (bs > 1 && (ShapedType::isDynamic(n) || n % bs != 0)))
+      return failure();
+    ReassociationIndices group;
+    if (bs > 1 && bs != n) {
+      group.push_back(layout.shape.size());
+      layout.shape.push_back(n / bs);
+      layout.reduce.push_back(false);
+      layout.retainedInputDims.push_back(i);
+    }
+    group.push_back(layout.shape.size());
+    layout.shape.push_back(bs > 1 ? bs : n);
+    layout.reduce.push_back(bs > 1);
+    if (bs == 1)
+      layout.retainedInputDims.push_back(i);
+    layout.reassociation.push_back(group);
+  }
+  return layout;
+}
