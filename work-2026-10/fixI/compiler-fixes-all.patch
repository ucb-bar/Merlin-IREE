+// Copyright 2026. Apache-2.0 WITH LLVM-exception.
+// Opt-in compatibility with pinned PyTorch 2.10 CPU arithmetic. Algorithm
+// templates contain no model data. Unsupported shapes use ordinary lowering.
+
+static llvm::cl::opt<bool> pytorchCpuNumerics(
+    "torch-pytorch-cpu-numerics", llvm::cl::init(false),
+    llvm::cl::desc(
+        "Use scoped PyTorch 2.10 AVX2 CPU mean/softmax/SiLU algorithms"));
+static llvm::cl::opt<unsigned> pytorchCpuThreads(
+    "torch-pytorch-cpu-reference-threads", llvm::cl::init(16),
+    llvm::cl::desc("Reference PyTorch intra-op threads for SiLU scalar tails"));
+
+static llvm::cl::opt<std::string> pytorchCpuMathLibrary(
+    "torch-pytorch-cpu-constant-math-library", llvm::cl::init(""),
+    llvm::cl::desc(
+        "Optional host VML library for static f32 sin/cos evaluation; "
+        "must export vsSin/vsCos with 32-bit element counts"));
+
+namespace {
+#include "PytorchCpuConstantFold.h"
+#include "PytorchCpuExpTemplates.inc"
+struct CpuRecipe {
+  std::string text;
+  unsigned id = 0;
+  std::string emit(const std::string &rhs) {
+    auto v = "%n" + std::to_string(++id);
+    text += v + " = " + rhs + "\n";
+    return v;
+  }
+  std::string integer(int64_t n) {
+    return emit("torch.constant.int " + std::to_string(n));
+  }
+};
+static std::string cpuType(ArrayRef<int64_t> shape, bool builtin = false) {
+  std::string s = builtin ? "tensor<" : "!torch.vtensor<[";
+  for (unsigned i = 0; i < shape.size(); ++i) {
+    if (i)
+      s += builtin ? "x" : ",";
+    s += std::to_string(shape[i]);
+  }
+  return s + (builtin ? "xf32>" : "],f32>");
+}
+static LogicalResult cpuInstall(Operation *op, StringRef body,
+                                StringRef result) {
+  std::string input, output;
+  llvm::raw_string_ostream a(input), b(output);
+  op->getOperand(0).getType().print(a);
+  op->getResult(0).getType().print(b);
+  auto module = parseSourceString<ModuleOp>(
+      "module { func.func @recipe(%arg: " + input + ") -> " + output + " {\n" +
+          body.str() + "return " + result.str() + " : " + output + "\n}}",
+      op->getContext());
+  if (!module)
+    return op->emitError("invalid CPU arithmetic recipe");
+  auto fn = *module->getOps<func::FuncOp>().begin();
+  IRMapping map;
+  map.map(fn.getArgument(0), op->getOperand(0));
+  OpBuilder builder(op);
+  for (auto &inst : fn.front().without_terminator())
+    builder.clone(inst, map);
+  op->getResult(0).replaceAllUsesWith(
+      map.lookup(fn.front().getTerminator()->getOperand(0)));
+  op->erase();
+  return success();
+}
+static LogicalResult cpuMean(Operation *op, ArrayRef<int64_t> shape) {
+  int64_t n = shape.back(), axis;
+  bool keep;
+  auto list = op->getOperand(1).getDefiningOp<PrimListConstructOp>();
+  if (!list || list.getNumOperands() != 1 ||
+      !matchPattern(list.getOperand(0), m_TorchConstantInt(&axis)) ||
+      (axis != -1 && axis != int64_t(shape.size() - 1)) ||
+      !matchPattern(op->getOperand(2), m_TorchConstantBool(&keep)) || !keep ||
+      !isa<Torch::NoneType>(op->getOperand(3).getType()) || n % 8 || n < 8 ||
+      n / 32 > 256)
+    return success();
+  CpuRecipe r;
+  auto t = cpuType(shape);
+  auto sh = SmallVector<int64_t>(shape);
+  sh.back() = 8;
+  auto m = cpuType(sh);
+  sh.back() = 1;
+  auto s = cpuType(sh);
+  auto ax = r.integer(shape.size() - 1), one = r.integer(1);
+  auto none = r.emit("torch.constant.none");
+  auto slice = [&](std::string x, int start, int end, std::string from,
+                   std::string to) {
+    auto lo = r.integer(start), hi = r.integer(end);
+    return r.emit("torch.aten.slice.Tensor " + x + ", " + ax + ", " + lo +
+                  ", " + hi + ", " + one + " : " + from +
+                  ", !torch.int, !torch.int, !torch.int, !torch.int -> " + to);
+  };
+  auto add = [&](std::string a, std::string b, std::string ty) {
+    return r.emit("torch.aten.add.Tensor " + a + ", " + b + ", " + one + " : " +
+                  ty + ", " + ty + ", !torch.int -> " + ty);
+  };
+  auto zslice = slice("%arg", 0, 8, t, m);
+  auto z = r.emit(
+      "torch.aten.zeros_like " + zslice + ", " + none + ", " + none + ", " +
+      none + ", " + none + ", " + none + " : " + m +
+      ", !torch.none, !torch.none, !torch.none, !torch.none, !torch.none -> " +
+      m);
+  std::string levels[4][4];
+  for (auto &lev : levels)
+    for (auto &v : lev)
+      v = z;
+  for (int i = 0; i < n / 32; ++i) {
+    for (int k = 0; k < 4; ++k)
+      levels[0][k] =
+          add(levels[0][k],
+              slice("%arg", i * 32 + k * 8, i * 32 + (k + 1) * 8, t, m), m);
+    if ((i + 1) % 16 == 0)
+      for (int j = 1; j < 4; ++j) {
+        for (int k = 0; k < 4; ++k) {
+          levels[j][k] = add(levels[j][k], levels[j - 1][k], m);
+          levels[j - 1][k] = z;
+        }
+        if (((i + 1) & (15 << (j * 4))) != 0)
+          break;
+      }
+  }
+  for (int j = 1; j < 4; ++j)
+    for (int k = 0; k < 4; ++k)
+      levels[0][k] = add(levels[0][k], levels[j][k], m);
+  for (int k = (n / 32) * 4; k < n / 8; ++k)
+    levels[0][0] =
+        add(levels[0][0], slice("%arg", k * 8, (k + 1) * 8, t, m), m);
+  auto p = levels[0][0];
+  for (int k = 1; k < 4; ++k)
+    p = add(p, levels[0][k], m);
+  auto sum = slice(z, 0, 1, m, s);
+  for (int k = 0; k < 8; ++k)
+    sum = add(sum, slice(p, k, k + 1, m, s), s);
+  auto div = r.emit("torch.constant.float " + std::to_string(double(n)));
+  auto out = r.emit("torch.aten.div.Scalar " + sum + ", " + div + " : " + s +
+                    ", !torch.float -> " + s);
+  return cpuInstall(op, r.text, out);
+}
+static LogicalResult cpuSoftmax(Operation *op, ArrayRef<int64_t> shape) {
+  int64_t axis;
+  if (shape.back() != 16 ||
+      !matchPattern(op->getOperand(1), m_TorchConstantInt(&axis)) ||
+      (axis != -1 && axis != int64_t(shape.size() - 1)))
+    return success();
+  // Identity FP32 dtype requests are common in exported attention graphs.
+  // A real dtype conversion continues through ordinary lowering.
+  if (op->getName().getStringRef() == "torch.aten.softmax.int" &&
+      !isa<Torch::NoneType>(op->getOperand(2).getType())) {
+    int64_t dtype;
+    if (!matchPattern(op->getOperand(2), m_TorchConstantInt(&dtype)) || dtype != 6)
+      return success();
+  }
+  CpuRecipe r;
+  auto sh = SmallVector<int64_t>(shape);
+  auto t = cpuType(sh);
+  sh.back() = 1;
+  auto m = cpuType(sh);
+  auto ax = r.integer(shape.size() - 1), one = r.integer(1);
+  auto ds = r.emit("torch.prim.ListConstruct " + ax +
+                   " : (!torch.int) -> !torch.list<int>");
+  auto yes = r.emit("torch.constant.bool true");
+  auto max = r.emit("torch.aten.amax %arg, " + ds + ", " + yes + " : " + t +
+                    ", !torch.list<int>, !torch.bool -> " + m);
+  auto sub = r.emit("torch.aten.sub.Tensor %arg, " + max + ", " + one + " : " +
+                    t + ", " + m + ", !torch.int -> " + t);
+  auto exp = r.emit("torch.aten.exp " + sub + " : " + t + " -> " + t),
+       val = exp;
+  for (int n : {8, 4, 2, 1}) {
+    sh.back() = n * 2;
+    auto prev = cpuType(sh);
+    sh.back() = n;
+    auto cur = cpuType(sh);
+    auto lo = r.integer(0), mid = r.integer(n), hi = r.integer(n * 2);
+    auto a =
+        r.emit("torch.aten.slice.Tensor " + val + ", " + ax + ", " + lo + ", " +
+               mid + ", " + one + " : " + prev +
+               ", !torch.int, !torch.int, !torch.int, !torch.int -> " + cur);
+    auto b =
+        r.emit("torch.aten.slice.Tensor " + val + ", " + ax + ", " + mid +
+               ", " + hi + ", " + one + " : " + prev +
+               ", !torch.int, !torch.int, !torch.int, !torch.int -> " + cur);
+    val = r.emit("torch.aten.add.Tensor " + a + ", " + b + ", " + one + " : " +
+                 cur + ", " + cur + ", !torch.int -> " + cur);
+  }
+  auto rec = r.emit("torch.aten.reciprocal " + val + " : " + m + " -> " + m);
+  auto out = r.emit("torch.aten.mul.Tensor " + exp + ", " + rec + " : " + t +
+                    ", " + m + " -> " + t);
+  return cpuInstall(op, r.text, out);
+}
+static LogicalResult cpuExp(Operation *op, ArrayRef<int64_t> shape, bool silu) {
+  CpuRecipe r;
+  auto t = cpuType(shape), bt = cpuType(shape, true);
+  auto in = r.emit("torch_c.to_builtin_tensor %arg : " + t + " -> " + bt);
+  auto empty = r.emit("tensor.empty() : " + bt);
+  std::string dims, iters;
+  for (unsigned i = 0; i < shape.size(); ++i) {
+    if (i) {
+      dims += ",";
+      iters += ",";
+    }
+    dims += "d" + std::to_string(i);
+    iters += "\"parallel\"";
+  }
+  auto am = "affine_map<(" + dims + ")->(" + dims + ")>";
+  r.text += "%generic = linalg.generic {indexing_maps = [" + am + ", " + am +
+            "], iterator_types = [" + iters + "]} ins(" + in + " : " + bt +
+            ") outs(" + empty + " : " + bt +
+            ") {\n^bb0(%input: f32, %unused: f32):\n";
+  r.text += silu ? "%raw = arith.negf %input : f32\n"
+                 : "%raw = arith.bitcast %input : f32 to f32\n";
+  // Keep float-to-integer range reduction defined for Inf/NaN and extreme
+  // finite values. exp(-104) rounds to zero; exp(100) overflows to infinity.
+  r.text += R"mlir(
+%expLo = arith.constant -1.040000e+02 : f32
+%expHi = arith.constant 1.000000e+02 : f32
+%expZero = arith.constant 0.000000e+00 : f32
+%isNan = arith.cmpf uno, %raw, %raw : f32
+%finiteInput = arith.select %isNan, %expZero, %raw : f32
+%below = arith.cmpf olt, %finiteInput, %expLo : f32
+%clippedLo = arith.select %below, %expLo, %finiteInput : f32
+%above = arith.cmpf ogt, %clippedLo, %expHi : f32
+%x = arith.select %above, %expHi, %clippedLo : f32
+)mlir";
+  r.text += std::string(vectorExp) + "\n";
+  std::string res = vectorResult;
+  if (silu) {
+    r.text += std::string(scalarExp) + "\n";
+    int64_t count = 1;
+    for (auto d : shape)
+      count *= d;
+    int64_t tasks =
+                std::min<int64_t>(std::max(1u, pytorchCpuThreads.getValue()),
+                                  (count + 32767) / 32768),
+            chunk = (count + tasks - 1) / tasks;
+    auto idx = r.emit("linalg.index 0 : index");
+    for (unsigned i = 1; i < shape.size(); ++i) {
+      auto dim =
+          r.emit("arith.constant " + std::to_string(shape[i]) + " : index");
+      idx = r.emit("arith.muli " + idx + ", " + dim + " : index");
+      auto next = r.emit("linalg.index " + std::to_string(i) + " : index");
+      idx = r.emit("arith.addi " + idx + ", " + next + " : index");
+    }
+    auto mask = r.emit("arith.constant false");
+    for (int64_t task = 0; task < tasks; ++task) {
+      int64_t begin = task * chunk, end = std::min(count, begin + chunk),
+              tail = begin + (end - begin) / 32 * 32;
+      if (tail == end)
+        continue;
+      auto lo = r.emit("arith.constant " + std::to_string(tail) + " : index"),
+           hi = r.emit("arith.constant " + std::to_string(end) + " : index");
+      auto ge = r.emit("arith.cmpi uge, " + idx + ", " + lo + " : index"),
+           lt = r.emit("arith.cmpi ult, " + idx + ", " + hi + " : index");
+      auto both = r.emit("arith.andi " + ge + ", " + lt + " : i1");
+      mask = r.emit("arith.ori " + mask + ", " + both + " : i1");
+    }
+    res = r.emit("arith.select " + mask + ", " + scalarResult + ", " + res +
+                 " : f32");
+    auto one = r.emit("arith.constant 1.000000e+00 : f32");
+    auto den = r.emit("arith.addf " + one + ", " + res + " : f32");
+    res = r.emit("arith.divf %input, " + den + " : f32");
+  }
+  res = r.emit("arith.select %isNan, %raw, " + res + " : f32");
+  r.text += "linalg.yield " + res + " : f32\n} -> " + bt + "\n";
+  auto out =
+      r.emit("torch_c.from_builtin_tensor %generic : " + bt + " -> " + t);
+  return cpuInstall(op, r.text, out);
+}
+static LogicalResult applyCpuCompatibility(func::FuncOp fn) {
+  if (failed(cpuFoldStaticTrig(fn)))
+    return failure();
+  // Revisit after softmax expansion so its exp gets the same SLEEF algorithm.
+  for (int phase = 0; phase < 2; ++phase) {
+    SmallVector<Operation *> ops;
+    fn.walk([&](Operation *op) {
+      auto name = op->getName().getStringRef();
+      if (name == "torch.aten.mean.dim" || name == "torch.aten.softmax.int" ||
+          name == "torch.aten._softmax" || name == "torch.aten.exp" ||
+          name == "torch.aten.silu")
+        ops.push_back(op);
+    });
+    for (auto *op : ops) {
+      auto ty = dyn_cast<ValueTensorType>(op->getOperand(0).getType());
+      if (!ty || !ty.hasSizes() || !ty.hasDtype() || !ty.getDtype().isF32() ||
+          ty.getSizes().empty() ||
+          llvm::any_of(ty.getSizes(), [](int64_t n) { return n <= 0; }))
+        continue;
+      auto name = op->getName().getStringRef();
+      LogicalResult status = success();
+      if (name == "torch.aten.mean.dim")
+        status = cpuMean(op, ty.getSizes());
+      else if (name == "torch.aten.softmax.int" ||
+               name == "torch.aten._softmax")
+        status = cpuSoftmax(op, ty.getSizes());
+      else
+        status = cpuExp(op, ty.getSizes(), name == "torch.aten.silu");
+      if (failed(status))
+        return failure();
+    }
+  }
+  return success();
+}
