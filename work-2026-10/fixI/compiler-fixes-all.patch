+// Dependency-closed static tensor evaluation. Never reads function inputs or
+// runtime files. Bounded to small tensors; unknown operations are rejected.
+struct CpuConstant {
+  SmallVector<int64_t> shape;
+  std::vector<float> data;
+};
+static std::optional<CpuConstant> cpuConstant(Value value, unsigned depth = 0) {
+  if (depth > 32)
+    return std::nullopt;
+  auto *op = value.getDefiningOp();
+  if (!op)
+    return std::nullopt;
+  auto ty = dyn_cast<ValueTensorType>(value.getType());
+  if (!ty || !ty.hasSizes() || !ty.hasDtype() ||
+      (!ty.getDtype().isF32() && !ty.getDtype().isSignedInteger(64)) ||
+      llvm::any_of(ty.getSizes(), [](int64_t n) { return n <= 0; }))
+    return std::nullopt;
+  CpuConstant out;
+  out.shape.assign(ty.getSizes().begin(), ty.getSizes().end());
+  int64_t size = 1;
+  for (auto d : out.shape) {
+    if (d > 65536 || size > 65536 / d)
+      return std::nullopt;
+    size *= d;
+  }
+  auto name = op->getName().getStringRef();
+  if (name == "torch.vtensor.literal") {
+    auto attr = cast<ValueTensorLiteralOp>(op).getValueAttr();
+    DenseElementsAttr dense;
+    if (auto a = dyn_cast<DenseElementsAttr>(attr))
+      dense = a;
+    else if (auto a = dyn_cast<DenseResourceElementsAttr>(attr)) {
+      auto *blob = a.getRawHandle().getBlob();
+      if (!blob)
+        return std::nullopt;
+      dense = DenseElementsAttr::getFromRawBuffer(cast<ShapedType>(a.getType()),
+                                                  blob->getData());
+    }
+    if (!dense)
+      return std::nullopt;
+    if (isa<mlir::FloatType>(dense.getElementType()))
+      for (auto f : dense.getValues<APFloat>())
+        out.data.push_back(f.convertToFloat());
+    else if (dense.getElementType().isInteger(64))
+      for (auto i : dense.getValues<APInt>())
+        out.data.push_back(float(i.getSExtValue()));
+    else
+      return std::nullopt;
+    return out;
+  }
+  auto index = [](ArrayRef<int64_t> shape, ArrayRef<int64_t> coord) {
+    int64_t off = 0;
+    for (unsigned i = 0; i < shape.size(); ++i)
+      off = off * shape[i] + coord[i];
+    return off;
+  };
+  auto coords = [](int64_t off, ArrayRef<int64_t> shape) {
+    SmallVector<int64_t> c(shape.size());
+    for (int i = int(shape.size()) - 1; i >= 0; --i) {
+      c[i] = off % shape[i];
+      off /= shape[i];
+    }
+    return c;
+  };
+  if (name == "torch.aten.cat") {
+    auto list = op->getOperand(0).getDefiningOp<PrimListConstructOp>();
+    int64_t axis;
+    if (!list || !matchPattern(op->getOperand(1), m_TorchConstantInt(&axis)))
+      return std::nullopt;
