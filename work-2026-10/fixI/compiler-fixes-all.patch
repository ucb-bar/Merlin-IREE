+    // a BLAS K=1 kernel and a standalone multiplication.
+    auto unsupported = [](float f) {
+      return std::signbit(f) || !std::isfinite(f);
+    };
+    if (llvm::any_of(x->data, unsupported) ||
+        llvm::any_of(y->data, unsupported))
+      return std::nullopt;
+    for (int64_t i = 0; i < size; ++i) {
+      auto c = coords(i, out.shape);
+      out.data.push_back(x->data[c[0] * x->shape[1] + c[1]] *
+                         y->data[c[0] * y->shape[2] + c[2]]);
+    }
+    return out;
+  }
+  return std::nullopt;
+}
+static LogicalResult cpuFoldStaticTrig(func::FuncOp fn) {
+  SmallVector<Operation *> ops;
+  fn.walk([&](Operation *op) {
+    if (op->getName().getStringRef() == "torch.aten.sin" ||
+        op->getName().getStringRef() == "torch.aten.cos")
+      ops.push_back(op);
+  });
+  for (auto *op : ops) {
+    auto ty = dyn_cast<ValueTensorType>(op->getResult(0).getType());
+    if (!ty || !ty.hasDtype() || !ty.getDtype().isF32())
+      continue;
+    auto x = cpuConstant(op->getOperand(0));
+    if (!x)
+      continue;
+    if (!pytorchCpuMathLibrary.empty()) {
+      // An explicit target-reference math library is an algorithm dependency,
+      // not a source of model data. Only evaluate dependency-closed constants.
+      std::string error;
+      auto library = llvm::sys::DynamicLibrary::getPermanentLibrary(
+          pytorchCpuMathLibrary.c_str(), &error);
+      if (!library.isValid())
+        return op->emitError("cannot load constant math library: ") << error;
+      const char *symbol =
+          op->getName().getStringRef() == "torch.aten.sin" ? "vsSin" : "vsCos";
+      using VmlFunction = void (*)(int, const float *, float *);
+      auto function =
+          reinterpret_cast<VmlFunction>(library.getAddressOfSymbol(symbol));
+      if (!function)
+        return op->emitError("constant math library lacks ") << symbol;
+      std::vector<float> result(x->data.size());
+      function(int(x->data.size()), x->data.data(), result.data());
+      x->data = std::move(result);
+    } else {
+      for (auto &f : x->data)
+        f = op->getName().getStringRef() == "torch.aten.sin"
+                ? float(std::sin(double(f)))
+                : float(std::cos(double(f)));
+    }
+    OpBuilder b(op);
+    auto tensor = RankedTensorType::get(x->shape, b.getF32Type());
+    auto dense = DenseElementsAttr::get(tensor, ArrayRef<float>(x->data));
+    auto replacement = ValueTensorLiteralOp::create(b, op->getLoc(), dense);
+    op->replaceAllUsesWith(replacement.getOperation());
+    op->erase();
+  }
+  return success();
+}
