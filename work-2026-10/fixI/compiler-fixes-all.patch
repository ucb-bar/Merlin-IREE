+      return std::nullopt;
+    out.data = x->data;
+    return out;
+  }
+  if (name == "torch.aten.expand") {
+    if (x->shape.size() > out.shape.size())
+      return std::nullopt;
+    for (int64_t i = 0; i < size; ++i) {
+      auto c = coords(i, out.shape);
+      SmallVector<int64_t> xc(x->shape.size());
+      for (unsigned j = 0; j < xc.size(); ++j) {
+        auto ci = c[c.size() - xc.size() + j];
+        if (x->shape[j] != 1 &&
+            x->shape[j] != out.shape[c.size() - xc.size() + j])
+          return std::nullopt;
+        xc[j] = x->shape[j] == 1 ? 0 : ci;
+      }
+      out.data.push_back(x->data[index(x->shape, xc)]);
+    }
+    return out;
+  }
+  if (name == "torch.aten.transpose.int") {
+    int64_t a, b;
+    if (!matchPattern(op->getOperand(1), m_TorchConstantInt(&a)) ||
+        !matchPattern(op->getOperand(2), m_TorchConstantInt(&b)))
+      return std::nullopt;
+    int64_t rank = out.shape.size();
+    if (a < 0)
+      a += rank;
+    if (b < 0)
+      b += rank;
+    if (a < 0 || b < 0 || a >= rank || b >= rank)
+      return std::nullopt;
+    for (int64_t i = 0; i < size; ++i) {
+      auto c = coords(i, out.shape);
+      std::swap(c[a], c[b]);
+      out.data.push_back(x->data[index(x->shape, c)]);
+    }
+    return out;
+  }
+  if (name == "torch.aten.matmul") {
+    if (!ty.getDtype().isF32())
+      return std::nullopt;
+    auto y = cpuConstant(op->getOperand(1), depth + 1);
+    if (!y || x->shape.size() != 3 || y->shape.size() != 3 ||
+        out.shape.size() != 3 || x->shape[2] != 1 || y->shape[1] != 1 ||
+        x->shape[0] != y->shape[0])
+      return std::nullopt;
