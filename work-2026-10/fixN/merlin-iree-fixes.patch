+static llvm::cl::opt<bool> clPreservePytorchBf16Rounds(
+    "iree-llvmcpu-preserve-pytorch-bf16-round-sites",
+    llvm::cl::desc("Preserve pinned PyTorch scalar BF16 RNE boundaries (f64 via f32)"),
