 // gemmini.* tensor-tier. The gemmini tensor ops still exist for the host-
 // IR debug path (lowerBackToIREE=true), but inside the dispatch we go
 // straight from linalg to ISA.
+// Collect only speculatable, effect-free dependencies in the same block.
+// Do not move allocations, loads, stores, or a potentially trapping index
+// calculation. Failure leaves the IR untouched and the epilogue unfused.
+static LogicalResult makeFoldOperandsAvailable(
+    ValueRange values, Operation *anchor, PatternRewriter &rewriter) {
+  DominanceInfo dominance(anchor->getParentOp());
+  SmallVector<Operation *> ordered;
+  llvm::SmallPtrSet<Operation *, 16> visited;
+  std::function<LogicalResult(Value)> collect = [&](Value value) {
+    if (!value || dominance.dominates(value, anchor))
+      return success();
+    Operation *def = value.getDefiningOp();
+    if (!def || def->getBlock() != anchor->getBlock() || !isPure(def))
+      return failure();
+    if (!visited.insert(def).second)
+      return success();
+    for (Value operand : def->getOperands())
+      if (failed(collect(operand)))
+        return failure();
+    ordered.push_back(def);
+    return success();
+  };
+  for (Value value : values)
+    if (failed(collect(value)))
+      return failure();
+  for (Operation *def : ordered)
+    rewriter.moveOpBefore(def, anchor);
+  return success();
+}
