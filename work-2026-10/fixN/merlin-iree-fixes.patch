+// RUN: torch-mlir-opt %s --convert-torch-to-linalg | FileCheck %s
+// Python scalar remains FP32 in BF16 mul.Scalar, until result rounding.
+// CHECK-LABEL: func.func @bf16_scalar
+// CHECK: arith.extf {{.*}} : bf16 to f32
+// CHECK: arith.mulf {{.*}} : f32
