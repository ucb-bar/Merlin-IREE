+
+// Preserve original scalar BF16 round sites before CPU promotion can erase
+// trunc/ext pairs. Integer RNE makes the original model boundary explicit.
+struct PreserveBf16RoundsPass
+    : PassWrapper<PreserveBf16RoundsPass, OperationPass<>> {
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(PreserveBf16RoundsPass)
+  void getDependentDialects(DialectRegistry &registry) const override {
+    registry.insert<arith::ArithDialect, math::MathDialect>();
+  }
+  void runOnOperation() override {
+    SmallVector<Operation *> sites;
+    getOperation()->walk([&](Operation *op) {
+      if (op->getNumResults() != 1 || !op->getResult(0).getType().isBF16())
+        return;
+      if (isa<arith::TruncFOp, arith::AddFOp, arith::SubFOp, arith::MulFOp,
+              arith::DivFOp, arith::SIToFPOp, arith::UIToFPOp, math::FmaOp>(op))
+        sites.push_back(op);
+    });
+    for (Operation *op : sites) {
+      OpBuilder b(op);
+      Location loc = op->getLoc();
+      Value x;
+      if (isa<arith::TruncFOp>(op)) {
+        x = op->getOperand(0);
+        if (x.getType().isF64())
+          x = arith::TruncFOp::create(b, loc, b.getF32Type(), x);
+        if (!x.getType().isF32()) continue;
+      } else {
