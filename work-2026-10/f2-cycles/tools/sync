#!/bin/bash
# sync: fetch every run from the F2 hosts to compute-1 (ssh -A), then pull runs/ + app metadata to garden.
export SSH_AUTH_SOCK=/home/loren/.ssh/agent/sock
G=/scratch2/loren/f2-cycles
timeout 600 ssh -A -F /scratch2/loren/aws/ssh/config merlin-compute-1 'cd /scratch/loren/f2cyc && for h in 192.168.3.251 192.168.3.142 192.168.3.211; do for r in $(ssh -o BatchMode=yes -o ConnectTimeout=8 ubuntu@$h "ls /var/tmp/f2cyc 2>/dev/null"); do bash src/f2fetch.sh $h $r; done; done' 2>&1 | grep -v "^$"
mkdir -p $G/runs $G/apps
timeout 600 ssh -F /scratch2/loren/aws/ssh/config merlin-compute-1 'cd /scratch/loren/f2cyc && tar cf - runs apps/*/cases.json apps/*/dispatch-classes.json apps/*/cfg.h apps/*/compile-*.log logs 2>/dev/null' > $G/stage/sync.tar && tar xf $G/stage/sync.tar -C $G
