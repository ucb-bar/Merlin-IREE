+  out.shape.assign(ty.getSizes().begin(), ty.getSizes().end());
+  int64_t size = 1;
+  for (auto d : out.shape) {
+    if (d > 65536 || size > 65536 / d)
+      return std::nullopt;
+    size *= d;
+  }
+  auto name = op->getName().getStringRef();
+  if (name == "torch.vtensor.literal") {
+    auto attr = cast<ValueTensorLiteralOp>(op).getValueAttr();
+    DenseElementsAttr dense;
+    if (auto a = dyn_cast<DenseElementsAttr>(attr))
+      dense = a;
+    else if (auto a = dyn_cast<DenseResourceElementsAttr>(attr)) {
+      auto *blob = a.getRawHandle().getBlob();
+      if (!blob)
+        return std::nullopt;
+      dense = DenseElementsAttr::getFromRawBuffer(cast<ShapedType>(a.getType()),
+                                                  blob->getData());
+    }
+    if (!dense)
+      return std::nullopt;
+    if (isa<mlir::FloatType>(dense.getElementType()))
+      for (auto f : dense.getValues<APFloat>())
+        out.data.push_back(f.convertToFloat());
+    else if (dense.getElementType().isInteger(64))
+      for (auto i : dense.getValues<APInt>())
+        out.data.push_back(float(i.getSExtValue()));
+    else
+      return std::nullopt;
+    return out;
+  }
