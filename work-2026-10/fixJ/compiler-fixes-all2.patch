+static LogicalResult cpuFoldStaticTrig(func::FuncOp fn) {
+  SmallVector<Operation *> ops;
+  fn.walk([&](Operation *op) {
+    if (op->getName().getStringRef() == "torch.aten.sin" ||
+        op->getName().getStringRef() == "torch.aten.cos")
+      ops.push_back(op);
+  });
+  for (auto *op : ops) {
+    auto ty = dyn_cast<ValueTensorType>(op->getResult(0).getType());
