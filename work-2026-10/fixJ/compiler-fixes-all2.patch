+#!/usr/bin/env python3
+"""Executable compiler numerical regressions against pinned TorchAO.
+Requires torch==2.10 and torchao==0.16. Run with --compiler, --runtime, --work-dir.
+"""
+import argparse, json, os, subprocess, tempfile
+from pathlib import Path
+import numpy as np
+import ml_dtypes
+import torch
+from torchao.quantization.quant_primitives import _choose_qparams_affine, _quantize_affine
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--compiler',required=True,type=Path)
+parser.add_argument('--runtime',required=True,type=Path)
+parser.add_argument('--work-dir',type=Path)
+args=parser.parse_args()
+C=args.compiler.resolve();RUN=args.runtime.resolve()
+D=args.work_dir or Path(tempfile.mkdtemp(prefix='affine-numerics-'))
+D.mkdir(parents=True,exist_ok=True)
+os.environ['OMP_NUM_THREADS']='8';torch.set_num_threads(8)
+commands=[];results={}
+def invoke(cmd,log):
+ commands.append([str(a) for a in cmd]);(D/'commands.json').write_text(json.dumps(commands,indent=2))
+ with log.open('w') as f:return subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT).returncode
+def execute(name,mlir,x,types,input_dtype="f32"):
+ p=D/(name+'.mlir');p.write_text(mlir);inp=D/(name+'-input.bin');x.astype(ml_dtypes.bfloat16 if input_dtype=='bf16' else 'f4').tofile(inp)
+ vmfb=D/(name+'.vmfb')
+ code=invoke([C,p,'--iree-hal-target-backends=llvm-cpu','--iree-llvmcpu-target-cpu=host','--iree-llvmcpu-number-of-threads=8','--iree-input-demote-f64-to-f32=false','--iree-vm-target-extension-f64=true','--iree-vm-target-truncate-unsupported-floats=false','-o',vmfb],D/(name+'-compile.log'))
+ if code:return {'compile_exit':code},None
+ outs=[D/f'{name}-{i}.bin' for i in range(len(types))]
+ shape='x'.join(map(str,x.shape))+'x'+input_dtype
+ code=invoke([RUN,f'--module={vmfb}','--device=local-task','--task_topology_group_count=8','--function=main',f'--input={shape}=@{inp}']+[f'--output=@{o}' for o in outs],D/(name+'-run.log'))
+ if code:return {'runtime_exit':code},None
+ return {},[np.fromfile(p,dtype=t) for p,t in zip(outs,types)]
+def tt(shape,dtype):return '!torch.vtensor<['+','.join(map(str,shape))+'],'+dtype+'>'
+def quant_ir(shape,block,keep=False,qmin=-127,qmax=127,fixed=None,unsigned=False,mapping='SYMMETRIC'):
+ qt='ui8' if unsigned else 'si8';xs=tt(shape,'f32');out=tt(shape,qt)
+ # Mirror the pinned _get_reduction_params, including singleton block axes.
+ compact=[]
+ for n,b in zip(shape,block):
+  if b==1:compact.append(n)
+  elif b!=n:compact.append(n//b)
+ ps=[n//b for n,b in zip(shape,block)] if keep else compact
+ pt=tt(ps,'f32');decls='\n'.join(f'%b{i} = torch.constant.int {b}' for i,b in enumerate(block))
+ bs=', '.join(f'%b{i}' for i in range(len(block)))
+ btypes=', '.join('!torch.int' for _ in block)
+ body=f'''%map = torch.constant.str "{mapping}"
+%dt = torch.constant.int {0 if unsigned else 1}
+%lo = torch.constant.int {qmin}
+%hi = torch.constant.int {qmax}
+%eps = torch.constant.float 1.000000e-05
+%none = torch.constant.none
+%keep = torch.constant.bool {'true' if keep else 'false'}
+{decls}
+%block = torch.prim.ListConstruct {bs} : ({btypes}) -> !torch.list<int>
+'''
+ if fixed is None:
+  body+=f'''%p:2 = torch.operator "torch.torchao.choose_qparams_affine"(%x, %map, %block, %dt, %lo, %hi, %eps, %none, %none, %keep) : ({xs}, !torch.str, !torch.list<int>, !torch.int, !torch.int, !torch.int, !torch.float, !torch.none, !torch.none, !torch.bool) -> ({pt}, {pt})\n'''
+  sc,zp='%p#0','%p#1'
+ else:
+  dims='x'.join(map(str,ps))+('x' if ps else '')
+  body+=f'%sc = torch.vtensor.literal(dense<{fixed[0]:.8e}> : tensor<{dims}f32>) : {pt}\n%zp = torch.vtensor.literal(dense<{fixed[1]:.8e}> : tensor<{dims}f32>) : {pt}\n'
+  sc,zp='%sc','%zp'
+ body+=f'''%q = torch.operator "torch.torchao.quantize_affine"(%x, %block, {sc}, {zp}, %dt, %lo, %hi) : ({xs}, !torch.list<int>, {pt}, {pt}, !torch.int, !torch.int, !torch.int) -> {out}
