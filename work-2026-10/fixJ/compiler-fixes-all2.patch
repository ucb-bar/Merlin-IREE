+        name == "torch.aten.layer_norm" || name == "torch.aten.gelu" ||
+        name == "torch.aten.scaled_dot_product_attention" ||
+        name == "torch.aten.softmax.int" || name == "torch.aten.matmul" ||
+        name == "torch.aten.amax")
+      ops.push_back(op);
+  });
+  for (auto *op : ops) {
+    if (op->getNumResults() != 1)
+      continue;
+    std::string key = op->getName().getStringRef().str() + "|";
+    llvm::raw_string_ostream out(key);
+    op->getResult(0).getType().print(out);
+    out << "|";
+    bool supported = true;
+    for (auto v : op->getOperands()) {
+      auto option = cpuOptionKey(v);
+      if (!option) {
+        supported = false;
+        break;
+      }
+      v.getType().print(out);
+      out << ":" << *option << "|";
+    }
+    if (!supported)
