+// Compile-time-only SLEEF vector adapter. Plain C ABI at the public boundary.
+// This translation unit is compiled with AVX512F on x86-64 so Clang selects
+// the vector ABI used by the provider. A function target attribute on a caller
+// alone does not change Clang's indirect-callee ABI for a vector function type.
+#include <cstddef>
+#if defined(__x86_64__)
+using CpuDouble8 = double __attribute__((vector_size(64)));
+extern "C" void torchMlirCpuPowD8(void *symbol, double base, double *data,
+                                  size_t size) {
+  auto f = reinterpret_cast<CpuDouble8 (*)(CpuDouble8, CpuDouble8)>(symbol);
+  for (size_t i = 0; i < size; i += 8) {
+    CpuDouble8 a{}, x{};
+    for (size_t j = 0; j < 8; ++j) {
+      a[j] = base;
+      x[j] = i + j < size ? data[i + j] : 0.;
+    }
+    auto y = f(a, x);
+    for (size_t j = 0; j < 8 && i + j < size; ++j)
+      data[i + j] = y[j];
+  }
+}
+#endif
