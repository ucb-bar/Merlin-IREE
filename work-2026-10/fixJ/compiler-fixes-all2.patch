+                       B + "\n%empty = tensor.empty() : " + B + "\n";
+    body += "%out = linalg.generic {indexing_maps = "
+            "[affine_map<(d0,d1)->(d0,d1)>, affine_map<(d0,d1)->(d0,d1)>], "
+            "iterator_types = [\"parallel\",\"parallel\"]} ins(%in : " +
+            B + ") outs(%empty : " + B +
+            ") {\n^bb0(%input: f64, %unused: f64):\n";
+    body += cpuDoubleTrig;
+    body += "linalg.yield " +
+            std::string(op->getName().getStringRef() == "torch.aten.sin"
+                            ? cpuDoubleSinResult
+                            : cpuDoubleCosResult) +
+            " : f64\n} -> " + B +
+            "\n%result = torch_c.from_builtin_tensor %out : " + B + " -> " + T +
+            "\n";
+    if (failed(cpuInstallValues(op, op->getOperands(), body)))
+      return failure();
+  }
+  return success();
