+struct CpuDoubleConstant {
+  SmallVector<int64_t> shape;
+  std::vector<double> data;
+};
+static std::optional<CpuDoubleConstant> cpuDoubleConstant(Value v,
+                                                          unsigned depth = 0) {
+  auto ty = dyn_cast<ValueTensorType>(v.getType());
+  auto *op = v.getDefiningOp();
+  if (depth > 16 || !op || !ty || !ty.hasSizes() || !ty.hasDtype() ||
+      !ty.getDtype().isF64())
+    return std::nullopt;
+  auto name = op->getName().getStringRef();
+  CpuDoubleConstant out;
+  out.shape.assign(ty.getSizes().begin(), ty.getSizes().end());
+  int64_t size = 1;
+  for (auto d : out.shape) {
+    if (d < 1 || d > 4096 || size > 4096 / d)
+      return std::nullopt;
+    size *= d;
+  }
+  if (name == "torch.aten.linspace") {
+    double start, end;
+    int64_t n, dtype;
+    if (!cpuScalar(op->getOperand(0), start) ||
+        !cpuScalar(op->getOperand(1), end) ||
+        !matchPattern(op->getOperand(2), m_TorchConstantInt(&n)) || n != size ||
+        n < 2 || !matchPattern(op->getOperand(3), m_TorchConstantInt(&dtype)) ||
+        dtype != 7)
+      return std::nullopt;
+    double step = (end - start) / (n - 1);
+    for (int64_t i = 0; i < n; ++i)
+      out.data.push_back(i < n / 2 ? std::fma(step, double(i), start)
+                                   : std::fma(-step, double(n - i - 1), end));
+    return out;
+  }
+  if (name == "torch.aten.pow.Scalar") {
+    double base;
+    if (!cpuScalar(op->getOperand(0), base) || !std::isfinite(base) ||
+        base <= 0 || pytorchCpuMathLibrary.empty())
+      return std::nullopt;
+    auto x = cpuDoubleConstant(op->getOperand(1), depth + 1);
+    if (!x)
+      return std::nullopt;
+#if defined(__x86_64__)
+    if (!__builtin_cpu_supports("avx512f"))
+      return std::nullopt;
+    std::string error;
+    auto lib = llvm::sys::DynamicLibrary::getPermanentLibrary(
+        pytorchCpuMathLibrary.c_str(), &error);
+    if (!lib.isValid())
+      return std::nullopt;
+    auto *f = lib.getAddressOfSymbol("Sleef_powd8_u10avx512f");
+    if (!f)
+      return std::nullopt;
+    out.data = std::move(x->data);
+    torchMlirCpuPowD8(f, base, out.data.data(), out.data.size());
+    return out;
+#else
+    return std::nullopt;
+#endif
+  }
+  if (name != "torch.aten.mul.Scalar" && name != "torch.aten.reciprocal" &&
+      name != "torch.aten.unsqueeze")
+    return std::nullopt;
+  auto x = cpuDoubleConstant(op->getOperand(0), depth + 1);
+  if (!x)
+    return std::nullopt;
+  out.data = std::move(x->data);
+  if (name == "torch.aten.mul.Scalar") {
+    double factor;
+    if (!cpuScalar(op->getOperand(1), factor))
+      return std::nullopt;
+    for (auto &a : out.data) {
+      volatile double product = a * factor;
+      a = product;
+    }
+  } else if (name == "torch.aten.reciprocal")
+    for (auto &a : out.data)
+      a = 1. / a;
+  return out;
+}
+static LogicalResult cpuFoldDoubleFormulas(func::FuncOp fn) {
+  SmallVector<Operation *> ops;
+  fn.walk([&](Operation *op) {
+    if (op->getName().getStringRef() == "torch.aten.unsqueeze")
+      ops.push_back(op);
+  });
+  for (auto *op : ops) {
+    auto x = cpuDoubleConstant(op->getResult(0));
+    if (!x)
+      continue;
+    OpBuilder b(op);
+    auto dense =
+        DenseElementsAttr::get(RankedTensorType::get(x->shape, b.getF64Type()),
+                               ArrayRef<double>(x->data));
+    auto replacement = ValueTensorLiteralOp::create(b, op->getLoc(), dense);
+    op->replaceAllUsesWith(replacement.getOperation());
+    op->erase();
+  }
+  return success();
+}
