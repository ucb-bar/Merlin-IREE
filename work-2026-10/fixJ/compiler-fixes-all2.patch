+      // An explicit target-reference math library is an algorithm dependency,
+      // not a source of model data. Only evaluate dependency-closed constants.
+      std::string error;
+      auto library = llvm::sys::DynamicLibrary::getPermanentLibrary(
+          pytorchCpuMathLibrary.c_str(), &error);
+      if (!library.isValid())
+        return op->emitError("cannot load constant math library: ") << error;
