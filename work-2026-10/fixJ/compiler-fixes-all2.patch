+    int64_t off = 0;
+    for (unsigned i = 0; i < shape.size(); ++i)
+      off = off * shape[i] + coord[i];
+    return off;
+  };
+  auto coords = [](int64_t off, ArrayRef<int64_t> shape) {
+    SmallVector<int64_t> c(shape.size());
