+        auto *convert = inputs[0].getDefiningOp();
+        if (convert && convert->getName().getStringRef() ==
+                           "torch.prims.convert_element_type") {
+          auto src =
+              dyn_cast<ValueTensorType>(convert->getOperand(0).getType());
+          int64_t dtype;
+          if (src && src.hasSizes() && src.hasDtype() &&
+              src.getDtype().isBF16() &&
+              src.getSizes() == ArrayRef<int64_t>({1, 3, 512, 512}) &&
+              matchPattern(convert->getOperand(1),
+                           m_TorchConstantInt(&dtype)) &&
