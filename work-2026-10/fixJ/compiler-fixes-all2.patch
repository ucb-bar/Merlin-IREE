+// Bounded compile-time formulas, with runtime positions/time preserved.
+static bool cpuScalar(Value v, double &x) {
+  int64_t i;
+  if (matchPattern(v, m_TorchConstantFloat(&x)))
+    return true;
+  if (matchPattern(v, m_TorchConstantInt(&i))) {
+    x = double(i);
+    return true;
+  }
+  return false;
+}
+static Operation *cpuDef(Value v, StringRef name) {
+  auto *op = v.getDefiningOp();
+  return op && op->getName().getStringRef() == name ? op : nullptr;
+}
+static std::optional<std::pair<int64_t, int64_t>>
+cpuIntegerBounds(Value v, unsigned depth = 0) {
+  auto ty = dyn_cast<ValueTensorType>(v.getType());
+  if (depth > 24 || !ty || !ty.hasDtype() || !ty.getDtype().isSignedInteger(64))
+    return std::nullopt;
+  auto *op = v.getDefiningOp();
+  if (!op)
+    return std::nullopt;
+  auto n = op->getName().getStringRef();
+  int64_t axis, alpha, c;
+  if (n == "torch.aten.cumsum") {
+    auto in = dyn_cast<ValueTensorType>(op->getOperand(0).getType());
+    if (!in || !in.hasSizes() || !in.hasDtype() ||
+        !in.getDtype().isInteger(1) || in.getSizes().size() != 2 ||
+        in.getSizes()[0] != 1 || in.getSizes()[1] < 1 ||
+        in.getSizes()[1] > 1024 ||
+        !matchPattern(op->getOperand(1), m_TorchConstantInt(&axis)) ||
+        (axis != 1 && axis != -1))
+      return std::nullopt;
+    return std::make_pair(0, in.getSizes()[1]);
+  }
+  if (n == "torch.aten.slice.Tensor" || n == "torch.aten.min.dim") {
+    if (n == "torch.aten.min.dim" && v != op->getResult(0))
+      return std::nullopt;
+    return cpuIntegerBounds(op->getOperand(0), depth + 1);
+  }
+  if (n != "torch.aten.sub.Scalar" && n != "torch.aten.sub.Tensor")
+    return std::nullopt;
+  if (!matchPattern(op->getOperand(2), m_TorchConstantInt(&alpha)) ||
+      alpha != 1)
+    return std::nullopt;
+  auto a = cpuIntegerBounds(op->getOperand(0), depth + 1);
+  if (!a)
+    return std::nullopt;
+  std::pair<int64_t, int64_t> b;
+  if (n == "torch.aten.sub.Scalar") {
+    if (!matchPattern(op->getOperand(1), m_TorchConstantInt(&c)) || c < -1024 ||
+        c > 1024)
+      return std::nullopt;
+    b = {c, c};
+  } else {
+    auto bounds = cpuIntegerBounds(op->getOperand(1), depth + 1);
+    if (!bounds)
+      return std::nullopt;
+    b = *bounds;
+  }
+  auto lo = a->first - b.second, hi = a->second - b.first;
+  if (lo < -4096 || hi > 4096)
+    return std::nullopt;
+  return std::make_pair(lo, hi);
+}
