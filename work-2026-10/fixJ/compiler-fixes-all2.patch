+namespace {
+#include "PytorchCpuConstantFold.h"
+#include "PytorchCpuExpTemplates.inc"
+struct CpuRecipe {
+  std::string text;
+  unsigned id = 0;
+  std::string emit(const std::string &rhs) {
+    auto v = "%n" + std::to_string(++id);
+    text += v + " = " + rhs + "\n";
+    return v;
+  }
+  std::string integer(int64_t n) {
+    return emit("torch.constant.int " + std::to_string(n));
+  }
+};
+static std::string cpuType(ArrayRef<int64_t> shape, bool builtin = false) {
+  std::string s = builtin ? "tensor<" : "!torch.vtensor<[";
+  for (unsigned i = 0; i < shape.size(); ++i) {
+    if (i)
+      s += builtin ? "x" : ",";
+    s += std::to_string(shape[i]);
+  }
+  return s + (builtin ? "xf32>" : "],f32>");
+}
+static LogicalResult cpuInstall(Operation *op, StringRef body,
+                                StringRef result) {
+  std::string input, output;
+  llvm::raw_string_ostream a(input), b(output);
+  op->getOperand(0).getType().print(a);
+  op->getResult(0).getType().print(b);
+  auto module = parseSourceString<ModuleOp>(
+      "module { func.func @recipe(%arg: " + input + ") -> " + output + " {\n" +
+          body.str() + "return " + result.str() + " : " + output + "\n}}",
+      op->getContext());
+  if (!module)
+    return op->emitError("invalid CPU arithmetic recipe");
+  auto fn = *module->getOps<func::FuncOp>().begin();
+  IRMapping map;
+  map.map(fn.getArgument(0), op->getOperand(0));
+  OpBuilder builder(op);
+  for (auto &inst : fn.front().without_terminator())
+    builder.clone(inst, map);
+  op->getResult(0).replaceAllUsesWith(
+      map.lookup(fn.front().getTerminator()->getOperand(0)));
+  op->erase();
+  return success();
+}
+static LogicalResult cpuMean(Operation *op, ArrayRef<int64_t> shape) {
+  int64_t n = shape.back(), axis;
+  bool keep;
+  auto list = op->getOperand(1).getDefiningOp<PrimListConstructOp>();
+  if (!list || list.getNumOperands() != 1 ||
+      !matchPattern(list.getOperand(0), m_TorchConstantInt(&axis)) ||
+      (axis != -1 && axis != int64_t(shape.size() - 1)) ||
+      !matchPattern(op->getOperand(2), m_TorchConstantBool(&keep)) || !keep ||
+      !isa<Torch::NoneType>(op->getOperand(3).getType()) || n % 8 || n < 8 ||
+      n / 32 > 256)
+    return success();
+  CpuRecipe r;
+  auto t = cpuType(shape);
+  auto sh = SmallVector<int64_t>(shape);
+  sh.back() = 8;
+  auto m = cpuType(sh);
+  sh.back() = 1;
+  auto s = cpuType(sh);
+  auto ax = r.integer(shape.size() - 1), one = r.integer(1);
+  auto none = r.emit("torch.constant.none");
+  auto slice = [&](std::string x, int start, int end, std::string from,
+                   std::string to) {
+    auto lo = r.integer(start), hi = r.integer(end);
+    return r.emit("torch.aten.slice.Tensor " + x + ", " + ax + ", " + lo +
+                  ", " + hi + ", " + one + " : " + from +
+                  ", !torch.int, !torch.int, !torch.int, !torch.int -> " + to);
+  };
+  auto add = [&](std::string a, std::string b, std::string ty) {
+    return r.emit("torch.aten.add.Tensor " + a + ", " + b + ", " + one + " : " +
+                  ty + ", " + ty + ", !torch.int -> " + ty);
+  };
+  auto zslice = slice("%arg", 0, 8, t, m);
+  auto z = r.emit(
+      "torch.aten.zeros_like " + zslice + ", " + none + ", " + none + ", " +
+      none + ", " + none + ", " + none + " : " + m +
+      ", !torch.none, !torch.none, !torch.none, !torch.none, !torch.none -> " +
+      m);
+  std::string levels[4][4];
+  for (auto &lev : levels)
+    for (auto &v : lev)
+      v = z;
+  for (int i = 0; i < n / 32; ++i) {
+    for (int k = 0; k < 4; ++k)
+      levels[0][k] =
+          add(levels[0][k],
+              slice("%arg", i * 32 + k * 8, i * 32 + (k + 1) * 8, t, m), m);
+    if ((i + 1) % 16 == 0)
+      for (int j = 1; j < 4; ++j) {
+        for (int k = 0; k < 4; ++k) {
+          levels[j][k] = add(levels[j][k], levels[j - 1][k], m);
+          levels[j - 1][k] = z;
+        }
+        if (((i + 1) & (15 << (j * 4))) != 0)
+          break;
+      }
+  }
+  for (int j = 1; j < 4; ++j)
+    for (int k = 0; k < 4; ++k)
+      levels[0][k] = add(levels[0][k], levels[j][k], m);
+  for (int k = (n / 32) * 4; k < n / 8; ++k)
+    levels[0][0] =
+        add(levels[0][0], slice("%arg", k * 8, (k + 1) * 8, t, m), m);
+  auto p = levels[0][0];
+  for (int k = 1; k < 4; ++k)
+    p = add(p, levels[0][k], m);
+  auto sum = slice(z, 0, 1, m, s);
+  for (int k = 0; k < 8; ++k)
+    sum = add(sum, slice(p, k, k + 1, m, s), s);
+  auto div = r.emit("torch.constant.float " + std::to_string(double(n)));
+  auto out = r.emit("torch.aten.div.Scalar " + sum + ", " + div + " : " + s +
+                    ", !torch.float -> " + s);
+  return cpuInstall(op, r.text, out);
+}
+static LogicalResult cpuSoftmax(Operation *op, ArrayRef<int64_t> shape) {
+  int64_t axis;
+  if (shape.back() != 16 ||
+      !matchPattern(op->getOperand(1), m_TorchConstantInt(&axis)) ||
+      (axis != -1 && axis != int64_t(shape.size() - 1)))
+    return success();
+  // Identity FP32 dtype requests are common in exported attention graphs.
+  // A real dtype conversion continues through ordinary lowering.
+  if (op->getName().getStringRef() == "torch.aten.softmax.int" &&
+      !isa<Torch::NoneType>(op->getOperand(2).getType())) {
+    int64_t dtype;
+    if (!matchPattern(op->getOperand(2), m_TorchConstantInt(&dtype)) || dtype != 6)
+      return success();
+  }
+  CpuRecipe r;
+  auto sh = SmallVector<int64_t>(shape);
+  auto t = cpuType(sh);
+  sh.back() = 1;
+  auto m = cpuType(sh);
+  auto ax = r.integer(shape.size() - 1), one = r.integer(1);
+  auto ds = r.emit("torch.prim.ListConstruct " + ax +
+                   " : (!torch.int) -> !torch.list<int>");
+  auto yes = r.emit("torch.constant.bool true");
+  auto max = r.emit("torch.aten.amax %arg, " + ds + ", " + yes + " : " + t +
+                    ", !torch.list<int>, !torch.bool -> " + m);
+  auto sub = r.emit("torch.aten.sub.Tensor %arg, " + max + ", " + one + " : " +
+                    t + ", " + m + ", !torch.int -> " + t);
+  auto exp = r.emit("torch.aten.exp " + sub + " : " + t + " -> " + t),
+       val = exp;
+  for (int n : {8, 4, 2, 1}) {
+    sh.back() = n * 2;
+    auto prev = cpuType(sh);
+    sh.back() = n;
+    auto cur = cpuType(sh);
+    auto lo = r.integer(0), mid = r.integer(n), hi = r.integer(n * 2);
+    auto a =
+        r.emit("torch.aten.slice.Tensor " + val + ", " + ax + ", " + lo + ", " +
+               mid + ", " + one + " : " + prev +
+               ", !torch.int, !torch.int, !torch.int, !torch.int -> " + cur);
+    auto b =
+        r.emit("torch.aten.slice.Tensor " + val + ", " + ax + ", " + mid +
+               ", " + hi + ", " + one + " : " + prev +
+               ", !torch.int, !torch.int, !torch.int, !torch.int -> " + cur);
+    val = r.emit("torch.aten.add.Tensor " + a + ", " + b + ", " + one + " : " +
+                 cur + ", " + cur + ", !torch.int -> " + cur);
+  }
+  auto rec = r.emit("torch.aten.reciprocal " + val + " : " + m + " -> " + m);
+  auto out = r.emit("torch.aten.mul.Tensor " + exp + ", " + rec + " : " + t +
+                    ", " + m + " -> " + t);
+  return cpuInstall(op, r.text, out);
+}
