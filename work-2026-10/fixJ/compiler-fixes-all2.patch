+// Scoped PyTorch 2.10 CPU recipes. The signature includes constant options;
+// tensor operands, affine weights, masks and epsilon remain runtime operands.
+#include "PytorchCpuSmolRecipes.inc"
+static std::optional<std::string> cpuOptionKey(Value v, unsigned depth = 0) {
+  if (depth > 8)
+    return std::nullopt;
+  if (isa<ValueTensorType>(v.getType()))
+    return std::string();
+  int64_t i;
+  double f;
+  bool b;
+  std::string s;
+  if (matchPattern(v, m_TorchConstantInt(&i)))
+    return "i" + std::to_string(i);
+  if (matchPattern(v, m_TorchConstantFloat(&f))) {
+    uint64_t bits;
+    static_assert(sizeof(bits) == sizeof(f));
+    memcpy(&bits, &f, sizeof(bits));
+    return "f" + std::to_string(bits);
+  }
+  if (matchPattern(v, m_TorchConstantBool(&b)))
+    return b ? "btrue" : "bfalse";
+  if (matchPattern(v, m_TorchConstantStr(s)))
+    return "s" + s;
+  if (isa<Torch::NoneType>(v.getType()))
+    return "none";
+  if (auto list = v.getDefiningOp<PrimListConstructOp>()) {
+    s = "[";
+    for (auto [j, arg] : llvm::enumerate(list.getOperands())) {
+      auto key = cpuOptionKey(arg, depth + 1);
+      if (!key)
+        return std::nullopt;
+      if (j)
+        s += ",";
+      s += *key;
+    }
+    return s + "]";
+  }
+  return std::nullopt;
+}
+static LogicalResult cpuInstallValues(Operation *op, ValueRange values,
+                                      StringRef body) {
+  std::string signature, output;
+  llvm::raw_string_ostream a(signature), b(output);
+  for (auto [i, v] : llvm::enumerate(values)) {
+    if (i)
+      a << ", ";
+    a << "%a" << i << ": ";
+    v.getType().print(a);
+  }
+  op->getResult(0).getType().print(b);
+  auto module = parseSourceString<ModuleOp>(
+      "module { func.func @recipe(" + signature + ") -> " + output + " {\n" +
+          body.str() + "return %result : " + output + "\n}}",
+      op->getContext());
+  if (!module)
+    return op->emitError("invalid scoped CPU recipe");
+  auto fn = *module->getOps<func::FuncOp>().begin();
+  IRMapping map;
+  for (auto [arg, v] : llvm::zip(fn.getArguments(), values))
+    map.map(arg, v);
+  OpBuilder builder(op);
+  for (auto &inst : fn.front().without_terminator())
+    builder.clone(inst, map);
+  op->getResult(0).replaceAllUsesWith(
+      map.lookup(fn.front().getTerminator()->getOperand(0)));
+  op->erase();
+  return success();
+}
+static LogicalResult cpuSmolRecipesForFunction(func::FuncOp fn) {
+  SmallVector<Operation *> ops;
+  fn.walk([&](Operation *op) {
+    auto name = op->getName().getStringRef();
